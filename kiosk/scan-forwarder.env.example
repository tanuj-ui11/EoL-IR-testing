# /etc/scan-forwarder.env  (chmod 600, owned by root: it holds the token)
# Only needed for Option B (background forwarder). Leave the service disabled for Option A.

# Scanner node. Find it with:  ls -l /dev/input/by-id/   (pick the one ending in -event-kbd)
SCANNER_DEVICE=/dev/input/by-id/usb-REPLACE_ME-event-kbd

# Where each scan is POSTed as JSON: {"serial","station_id","scanned_at","source"}
# Ask LeanWatts for the real endpoint and auth scheme; this is a placeholder.
SCAN_WEBHOOK_URL=https://ops.leanwatts.com/REPLACE_WITH_WEBHOOK_PATH
SCAN_WEBHOOK_TOKEN=

STATION_ID=LINE1-ST01

# Optional: only forward codes that fully match this regex (filters out stray scans of carton barcodes, etc.)
SCAN_PATTERN=
